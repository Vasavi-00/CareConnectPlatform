DEBUG=True

SECRET_KEY=replace-with-your-own-django-secret-key

DATABASE_URL=replace-with-your-neon-development-connection-string

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=yourgmail@gmail.com

# Frontend URL used for generating direct password reset links in emails
FRONTEND_URL=http://localhost:5173

# Optional: user-initiated tel: fallback, in international format (example placeholder only).
# Configure only after confirming the correct local emergency-service number for your deployment region.
EMERGENCY_SERVICES_PHONE=

# AI Companion Configuration
# Supports Google Gemini (recommended), local Ollama, or OpenAI.
# -------------------------------------------------------------
# Option 1: Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_COMPANION_PROVIDER=gemini
AI_COMPANION_MODEL=gemini-flash-lite-latest
AI_COMPANION_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Option 2: Local Ollama (run: ollama run llama3.2, no API key needed)
# AI_COMPANION_PROVIDER=ollama
# AI_COMPANION_MODEL=llama3.2
# AI_COMPANION_API_URL=http://localhost:11434/v1/chat/completions

# Option 3: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# AI_COMPANION_MODEL=gpt-4o-mini

AI_COMPANION_CONTEXT_MESSAGES=12
# Optional style preferences are appended before the safety instructions.
AI_COMPANION_STYLE_GUIDANCE=Use calm, respectful wording and one question at a time.
AI_COMPANION_TIMEOUT=30

# Speech-to-Text Transcription for voice conversations (optional; falls back to AI_COMPANION_API_KEY).
# OpenAI Whisper or compatible endpoint. Supports audio/webm, audio/mp4, audio/wav, audio/ogg.
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-1
# AI_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
AI_TRANSCRIPTION_TIMEOUT=30

